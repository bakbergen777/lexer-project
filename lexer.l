%option noyywrap
%option yylineno
%option case-sensitive

%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* ----- Token-category tags -------------------------------- */
#define T_KEYWORD   "KEYWORD   "
#define T_IDENT     "IDENT     "
#define T_INT       "INT_CONST "
#define T_FLOAT     "FLT_CONST "
#define T_STRING    "STR_CONST "
#define T_CHAR      "CHR_CONST "
#define T_OP        "OPERATOR  "
#define T_PUNCT     "PUNCT     "
#define T_COMMENT   "COMMENT   "

static int  g_col      = 1;          /* current column            */
static int  g_tok_cnt  = 0;          /* total tokens produced     */
static int  g_kw_cnt   = 0;
static int  g_id_cnt   = 0;
static int  g_num_cnt  = 0;
static int  g_op_cnt   = 0;
static int  g_err_cnt  = 0;

/* helper: print one token row and advance the column counter   */
static void emit(const char *kind, const char *lex)
{
    printf("  %4d:%-3d  %s  %s\n", yylineno, g_col, kind, lex);
    g_col   += (int)strlen(lex);
    g_tok_cnt++;
}
%}

/* ----- Reusable regex macros ------------------------------ */
DIGIT       [0-9]
LETTER      [a-zA-Z_]
ID          {LETTER}({LETTER}|{DIGIT})*
INT         {DIGIT}+
FLOAT       {DIGIT}+"."{DIGIT}+([eE][+-]?{DIGIT}+)?
STRING      \"([^\"\\\n]|\\.)*\"
CHARCONST   \'([^\'\\\n]|\\.)\'
WS          [ \t]+
NL          \r?\n
LCOMMENT    "//"[^\n]*
BCOMMENT    "/*"([^*]|\*+[^*/])*\*+"/"

%%

  /* ---------- whitespace and newlines ---------- */
{WS}        { g_col += (int)yyleng; }
{NL}        { g_col = 1; }

  /* ---------- comments (single + multi-line) ---------- */
{LCOMMENT}  { emit(T_COMMENT, "// ...");  g_kw_cnt++; }
{BCOMMENT}  { emit(T_COMMENT, "/* ... */"); }

  /* ---------- keywords (longest match wins via order) ---------- */
"if"        |
"else"      |
"while"     |
"for"       |
"do"        |
"return"    |
"break"     |
"continue"  |
"int"       |
"float"     |
"double"    |
"char"      |
"void"      |
"const"     |
"struct"    |
"typedef"   |
"sizeof"    |
"switch"    |
"case"      |
"default"   { emit(T_KEYWORD, yytext); g_kw_cnt++; }

  /* ---------- multi-char operators (must precede single-char) ---------- */
"=="|"!="|"<="|">="|"&&"|"||"|"++"|"--"|"+="|"-="|"*="|"/="|"->" {
              emit(T_OP, yytext); g_op_cnt++;
            }

  /* ---------- single-char operators ---------- */
[+\-*/%=<>!&|^~]   { emit(T_OP, yytext); g_op_cnt++; }

  /* ---------- punctuation ---------- */
[(){}\[\];,.:?#] { emit(T_PUNCT, yytext); }

  /* ---------- numeric and string literals ---------- */
{FLOAT}     { emit(T_FLOAT,  yytext); g_num_cnt++; }
{INT}       { emit(T_INT,    yytext); g_num_cnt++; }
{STRING}    { emit(T_STRING, yytext); }
{CHARCONST} { emit(T_CHAR,   yytext); }

  /* ---------- identifiers (after keywords so keywords win) ---------- */
{ID}        { emit(T_IDENT, yytext); g_id_cnt++; }

  /* ---------- unrecognised character ---------- */
.           { fprintf(stderr,
                "  [error] line %d col %d: unexpected character '%s'\n",
                yylineno, g_col, yytext);
              g_col += (int)yyleng;
              g_err_cnt++;
            }

%%

int main(int argc, char **argv)
{
    if (argc > 1) {
        FILE *fp = fopen(argv[1], "r");
        if (!fp) { perror(argv[1]); return 1; }
        yyin = fp;
    }

    puts("============================================================");
    puts(" Lexical analyzer generated by Flex");
    puts(" Compiler Principles - Group Project");
    puts("============================================================");
    puts("  line:col  category   lexeme");
    puts("  --------  ---------  ----------------------");

    yylex();

    puts("------------------------------------------------------------");
    printf("  Summary: total=%d  keywords=%d  identifiers=%d  "
           "numbers=%d  operators=%d  errors=%d\n",
           g_tok_cnt, g_kw_cnt, g_id_cnt, g_num_cnt, g_op_cnt, g_err_cnt);
    puts("============================================================");
    return g_err_cnt == 0 ? 0 : 2;
}
